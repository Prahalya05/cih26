# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Local: docker compose up -d  (see docker-compose.yml)
DATABASE_URL=postgresql://postgres:disha@localhost:5432/disha

# Gemini (optional). Without it, answers fall back to keyword matching and
# work samples wait for a teacher to score them.
GEMINI_API_KEY=

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the web app finds the API (empty = same origin)
VITE_API_URL=

# Storage bucket for portfolio media that students chose to share
MEDIA_BUCKET=

# Token for admin-only endpoints (loading the knowledge base, reports)
ADMIN_TOKEN=change-me
