# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Local: docker compose up -d  (see docker-compose.yml)
DATABASE_URL=postgresql://postgres:disha@localhost:5432/disha

# Gemini (optional). Without it, answers fall back to keyword matching and
# work samples wait for a teacher to score them.
GEMINI_API_KEY=

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the web app finds the API (empty = same origin)
VITE_API_URL=

# Storage bucket for portfolio media that students chose to share
MEDIA_BUCKET=

# Token for admin-only endpoints (loading the knowledge base, reports)
ADMIN_TOKEN=change-me

# Sign-in (apps/api/app/routers/accounts.py). AUTH_SECRET hides phone numbers/emails (HMAC); use a long random value.
AUTH_SECRET=change-me-long-random
# Encryption key for student_private (names, phone numbers, guardian names via pgcrypto). Separate from AUTH_SECRET.
# Required when OTP_DEMO=0; in demo mode (OTP_DEMO=1) falls back to dev-only-pii-key-change-me.
PII_KEY=
# 1 = show the one-time code on screen (no SMS/email provider). Set 0 with SMTP_* for real email codes.
OTP_DEMO=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: AI rater agreement to use for auto-confirm before 20 teacher-checked pairs exist (demos only; shown as "demo calibration")
DEMO_AI_KAPPA=

# Teacher course payments. With Razorpay test keys (rzp_test_...) checkout opens Razorpay and the server checks the
# signature. Without them, PAYMENTS_DEMO=1 gives a labelled demo payment where no money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENTS_DEMO=1

# Paid-job confirmations above this INR amount require buyer phone OTP.
ORDER_OTP_THRESHOLD_INR=500
